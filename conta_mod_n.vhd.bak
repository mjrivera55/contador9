library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;
 
entity conta_mod_n is
 generic (
        BITS : integer := BITS_MOD_N
    );
port (
        clk    : in  std_logic;
        rst    : in  std_logic;
        en     : in  std_logic;
        mod_n  : in  unsigned(BITS - 1 downto 0);
        q      : out std_logic_vector(6 downto 0);
        tc     : out std_logic
    );
end entity conta_mod_n;